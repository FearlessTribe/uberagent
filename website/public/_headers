  Cross-Origin-Opener-Policy: same-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=()
  Content-Security-Policy: default-src 'self'; script-src 'self' https://www.googletagmanager.com https://www.google-analytics.com https://www.provenexpert.com https://assets.calendly.com; style-src 'self' 'unsafe-inline' https://www.provenexpert.com https://assets.calendly.com; img-src 'self' data: blob: https://www.provenexpert.com https://images.provenexpert.com https://www.google-analytics.com https://www.googletagmanager.com https://assets.calendly.com; font-src 'self' https://assets.calendly.com; connect-src 'self' https://www.provenexpert.com https://www.google-analytics.com https://www.googletagmanager.com https://region1.google-analytics.com https://calendly.com https://assets.calendly.com; media-src 'self'; frame-src https://calendly.com https://www.calendly.com; object-src 'none'; base-uri 'self'; frame-ancestors 'none'

/assets/*.js
  Content-Type: application/javascript; charset=utf-8

/assets/*.css
